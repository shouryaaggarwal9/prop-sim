# ── Supabase (public — safe for browser bundle) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# ── App ───────────────────────────────────────────────────────────
# Absolute origin of THIS deployment. Used by Stripe redirect URLs and
# Supabase email links. localhost:3000 in dev, your domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (SECRET — server only, never NEXT_PUBLIC_) ─────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase (SECRET — server only; webhook account activation) ───
SUPABASE_SECRET_KEY=<service role / secret key>